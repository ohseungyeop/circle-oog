# 이 파일을 .env.local(로컬) 또는 .env.prd(운영) 로 복사한 뒤 값을 채우세요.
# .env.local / .env.prd 는 git 에 올라가지 않습니다. 서버마다 직접 작성합니다.
# NODE_ENV 에 따라 app.js 가 .env.<NODE_ENV> 를 읽습니다 (npm run local → .env.local, npm run prd → .env.prd)

# 서버
BACKEND_PORT=
BACKEND_URL=
FRONTEND_URL=
LOG_LEVEL=info

# 쿠키 (운영에서만. 예: .valueonsys.com)
COOKIE_DOMAIN=

# DB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=vos_oog

# 파일 경로
ATTACH_PATH=
TEMPLATE_PATH=

# 세션·로그인 링크 서명 비밀. 바꾸면 모두 로그아웃됩니다. 생성: openssl rand -base64 32
JWT_SECRET_KEY=

# 로그인 허용 목록의 관리자 (쉼표로 여러 명). 사용자 승인·차단 가능
ADMIN_EMAILS=

# 메일 발송 (Gmail: 2단계 인증 켜고 앱 비밀번호 발급)
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# 구글 로그인 (선택). 승인된 리디렉션 URI: {BACKEND_URL}/vos/oog/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
