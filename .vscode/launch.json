{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Backend Debugger",
            "port": 3301,
            "restart": true,
            "protocol": "inspector"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Frontend Debugger",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
